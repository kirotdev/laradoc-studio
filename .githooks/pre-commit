#!/usr/bin/env bash
# Laradoc Studio Pre-Commit Hook
# Validates staged changes against sensitive files and corruption markers

set -e

# 1. Block accidental staging of private keys, SSL secrets, and environment files
SENSITIVE_PATTERNS='(\.key$|\.pem$|\.p12$|\.pfx$|ca\.key|wildcard\.test\.key|^\.env(\..+)?$)'
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

for FILE in $STAGED_FILES; do
    if echo "$FILE" | grep -Eq "$SENSITIVE_PATTERNS"; then
        echo "❌ [GIT HOOK ERROR] Sensitive file detected: $FILE"
        echo "   Private keys, certificates, and .env files must never be committed."
        echo "   Please unstage this file with 'git reset HEAD $FILE' and check .gitignore."
        exit 1
    fi
done

# 2. Block unresolved merge conflict markers
for FILE in $STAGED_FILES; do
    if git show ":$FILE" | grep -Eq '^(<<<<<<<|=======|>>>>>>>)'; then
        echo "❌ [GIT HOOK ERROR] Unresolved merge conflict markers found in: $FILE"
        exit 1
    fi
done

# 3. Check for oversized binary files (> 15MB)
MAX_BYTES=15728640
for FILE in $STAGED_FILES; do
    if [ -f "$FILE" ]; then
        SIZE=$(wc -c < "$FILE" | tr -d ' ')
        if [ "$SIZE" -gt "$MAX_BYTES" ]; then
            echo "❌ [GIT HOOK ERROR] File is larger than 15MB ($SIZE bytes): $FILE"
            echo "   Please use Git LFS or external artifact storage."
            exit 1
        fi
    fi
done

exit 0
